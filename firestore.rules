rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Pagar akhir untuk Developer Panel. Email diambil dari token Firebase Auth,
    // bukan dari field dokumen yang bisa dikirim oleh klien.
    function isDeveloper() {
      return signedIn() &&
        request.auth.token.email.lower() == 'ibrahimhafiz840@gmail.com';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isDeveloper();
      allow create: if isOwner(userId);

      // Pemilik boleh menyimpan profilnya. Developer hanya boleh mengubah totalXp
      // dokumen pengguna lain lewat Testing Panel.
      allow update: if isOwner(userId) || (
        isDeveloper() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalXp'])
      );

      allow delete: if false;
    }
  }
}
