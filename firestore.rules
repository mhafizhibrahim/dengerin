rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Pagar akhir untuk Developer Panel. Email diambil dari token Firebase Auth,
    // bukan dari field dokumen yang bisa dikirim oleh klien.
    function isDeveloper() {
      return signedIn() &&
        request.auth.token.email.lower() == 'ibrahimhafiz840@gmail.com';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isDeveloper();
      allow create: if isOwner(userId);

      // Pemilik boleh menyimpan profilnya. Developer hanya boleh mengubah totalXp
      // dokumen pengguna lain lewat Testing Panel.
      allow update: if isOwner(userId) || (
        isDeveloper() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalXp'])
      );

      allow delete: if false;

      // Koleksi tanpa batas: metadata playlist, entri lagu (boleh duplikat), dan
      // lagu disukai. Semua ditulis langsung oleh pemilik; Room tetap sumber lokal.
      match /playlists/{playlistId} {
        allow read: if isOwner(userId) || isDeveloper();
        allow create, update: if isOwner(userId);
        // Penghapusan permanen: pemilik boleh menghapus induk playlist ...
        allow delete: if isOwner(userId);

        match /tracks/{entryId} {
          allow read: if isOwner(userId) || isDeveloper();
          allow create, update: if isOwner(userId);
          // ... dan seluruh entri lagunya (dihapus per potongan 400 dokumen).
          allow delete: if isOwner(userId);
        }
      }

      match /liked_tracks/{trackId} {
        allow read: if isOwner(userId) || isDeveloper();
        allow create, update, delete: if isOwner(userId);
      }
    }
  }
}
